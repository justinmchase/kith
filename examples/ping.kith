export Child;
export Ping;
export Main;

component Child {
  start Idle {
    on ({ kind: "Ping", n: number }) {
      complete { kind: "Pong", n: n };
    }
  }
}

workflow Ping {
  field heard: number = 0;
  Child child;

  start Run {
    on ({ kind: "Ping", n: number }) {
      send to child { kind: "Ping", n: n };
    }
    on ({ kind: "Pong", n: number }) {
      heard -> n;
    }
  }
}

export scene Main {
  Ping() {
    child = Child();
  }
}
