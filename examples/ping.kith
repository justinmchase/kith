component Child {
  start Idle {
    on { kind: "Ping", n: n: any } {
      bubble { kind: "Pong", n: n };
    }
  }
}

component Parent {
  field heard: (number) = 0;
  child Child child;

  start Idle {
    on { kind: "Ping", n: n: any } {
      down child { kind: "Ping", n: n };
    }
    on { kind: "Pong", n: n: any } {
      heard -> n;
    }
  }
}

root Parent;
