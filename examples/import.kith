export Worker;
export Count;
export Import;
export Main;

component Worker {
  start Idle {
    on { kind: "Item", item: any, index: number } {
      complete { kind: "Done", item: item, index: index };
    }
  }
}

component Count {
  start Idle {
    on { kind: "Reduce", acc: any, item: any } {
      complete (add acc 1);
    }
  }
}

workflow Import {
  start fanout items -> Worker reduce Count from 0 then succeed;
}

export scene Main {
  Import();
}
