export Worker;
export Count;
export Import;
export Main;

component Worker {
  start Idle {
    on { kind: "Item", item: any, index: number } {
      complete { kind: "Done", item: item, index: index };
    }
  }
}

component Count {
  field total: number;

  start {
    on "item" item: any {
      total -> (add total 1);
    }
    else complete total;
  }
}

workflow Import {
  start fanout items -> Worker reduce Count from 0 then succeed;
}

export scene Main {
  Import();
}
