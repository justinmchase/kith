export ValidateOrder;
export ChargeCard;
export Carrier;
export Summarize;
export Order;
export Main;

component ValidateOrder {
  start Idle {
    on { kind: "Order", orderId: any, items: any, card: any } {
      complete { kind: "Accepted", orderId: orderId, items: items, card: card };
    }
    else {
      complete { kind: "Rejected" };
    }
  }
}

component ChargeCard {
  start Idle {
    on { kind: "Accepted", card: "ok", orderId: any, items: any } {
      complete { kind: "Paid", orderId: orderId, items: items };
    }
    on { kind: "Accepted", orderId: any, items: any, card: any } {
      complete { kind: "Declined", orderId: orderId };
    }
  }
}

component Carrier {
  field item: string = "";
  field index: number = 0;

  start Waiting {
    on { kind: "Item", item: any, index: number } {
      item -> item;
      index -> index;
      print { kind: "PickupRequested", item: item, index: index };
      goto Shipping;
    }
  }

  state Shipping {
    on { kind: "Delivered" } {
      complete { kind: "Shipped", item: item, index: index };
    }
  }
}

component Summarize {
  field total: number = 0;

  start {
    on item: any {
      total -> (add total 1);
      print { kind: "Tally", total: total, status: item.kind };
    }
    else complete { kind: "Summarize" total };
  }
}

workflow Order {
  start Validate: ValidateOrder then Stock;
  Stock: pick {
    ({ kind: "Accepted" }) -> Pay;
    else -> Reject;
  };
  Pay: ChargeCard then Paid;
  Paid: pick {
    ({ kind: "Paid" }) -> Fulfill;
    else -> Decline;
  };
  Fulfill: fanout items -> Carrier reduce Summarize then succeed;
  Reject: fail "invalid order";
  Decline: fail "payment declined";
}

export scene Main {
  Order();
}
