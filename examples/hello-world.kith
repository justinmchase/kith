import "kith:http" Server;
import "kith:process" Process;

export Hello;
export Main;

component Hello {
  field host: string?;
  server: Server;
  proc: Process;

  start {
    on init {
      send to proc "Env" ["HOST_NAME" "PORT"];
    }
    on up "Env" values:{ HOST_NAME: (string | null) PORT: (string | null) } {
      host -> (coalesce HOST_NAME "127.0.0.1");
      send to server "Listen" host (int (coalesce PORT "3000"));
    }
    on up "Listening" port:number {
      (print "Server running at http://{host}:{port}/");
      goto Listening;
    }
  }

  state Listening {
    on up "Request" id:string method:string path:string headers:any {
      send to server "Status" id 200 { "Content-Type": "text/plain" };
      send to server "Push" id "Hello, World!\n";
      send to server "BodyEnd" id;
    }
  }
}

export scene Main {
  Hello() {
    server = Server();
    proc = Process();
  }
}
