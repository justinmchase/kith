import "kith:http" Server;
import "kith:process" Process;

export Service;
export Main;

component Service {
  server: Server;
  proc: Process;

  start {
    on init {
      send to proc "Env" "PORT";
    }
    on up "Env" name:"PORT" value:string {
      send to server "Listen" "127.0.0.1" (int value);
    }
    on up "Missing" name:"PORT" {
      send to proc "Exit" 1;
    }
    on up "Listening" port:number {
      goto Listening;
    }
  }

  state Listening {
    on up "Request" id:string method:string path:string headers:any {
      send to server "Status" id 200 { "Content-Type": "text/plain" };
      send to server "Push" id "ok\n";
      send to server "BodyEnd" id;
    }
  }
}

export scene Main {
  Service() {
    server = Server();
    proc = Process();
  }
}
