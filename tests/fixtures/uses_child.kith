import "./child.kith" Child;

export Parent;
export Main;

component Parent {
  field heard: number = 0;
  Child child;

  start Idle {
    on ({ kind: "Ping", n: number }) {
      send to child { kind: "Ping", n: n };
    }
    on ({ kind: "Pong", n: number }) {
      heard -> n;
    }
  }
}

export scene Main {
  Parent() {
    child = Child();
  }
}
