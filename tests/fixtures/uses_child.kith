import "./child.kith" Child;

export Ping;
export Main;

component Ping {
  field heard: number = 0;
  Child child;

  start {
    on down "Ping" n:number {
      send to child "Ping" n;
    }
    on up "Pong" n:number {
      heard -> n;
    }
  }
}

export scene Main {
  Ping() {
    child = Child();
  }
}
