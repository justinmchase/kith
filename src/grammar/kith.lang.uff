import "@justinmchase/uffda/source" Source;
import "@justinmchase/uffda/tokenizer" TokenizerNoWhitespace;
import "@justinmchase/uffda/pattern" Pattern;
import "@justinmchase/uffda/expression" Expression;

export KithLang;

decorator Language<c:any> = c;

rule Identifier =
  s:string & [(\cL | "_") (\cL | \cNd | "_")*]
  -> s
;

rule SpecifierChar = not "\"" c:any -> c;

rule ModuleSpecifier =
  "\"" p:SpecifierChar* "\""
  -> (join p "")
;

rule ImportName = n:Identifier -> n;

rule Import =
  "import" u:ModuleSpecifier n:ImportName r:ImportName* ";"
  -> { kind: "import", moduleUrl: u, names: (flat [[n] (flat r)]) }
;

rule ExportName = n:Identifier -> { kind: "export", name: n };

rule ExportList =
  "export" not "scene" not "component" not "workflow" f:ExportName r:ExportName* ";"
  -> (flat [[f] (flat r)])
;

rule Field =
  "field" n:Identifier ":" p:Pattern "=" e:Expression ";"
  -> { kind: "field", name: n, pattern: p, init: e }
;

rule Port =
  not "field" not "start" not "state" not "step" not "join"
  k:Identifier n:Identifier ";"
  -> { kind: "port", component: k, name: n }
;

rule Assign =
  n:Identifier "-" ">" e:Expression ";"
  -> { kind: "assign", field: n, expression: e }
;

rule SendUp =
  "send" "up" e:Expression ";"
  -> { kind: "sendUp", message: e }
;

rule SendTo =
  "send" "to" n:Identifier e:Expression ";"
  -> { kind: "sendTo", port: n, message: e }
;

rule SendDown =
  | (
    "send" "down" "any" e:Expression ";"
    -> { kind: "sendDown", component: null, message: e }
  )
  | (
    "send" "down" n:Identifier e:Expression ";"
    -> { kind: "sendDown", component: n, message: e }
  )
;

rule Complete =
  "complete" e:Expression ";"
  -> { kind: "complete", message: e }
;

rule Fanout =
  "fanout" e:Expression "-" ">" k:Identifier ";"
  -> { kind: "fanout", collection: e, component: k }
;

rule Goto =
  "goto" n:Identifier ";"
  -> { kind: "goto", step: n }
;

rule ComponentStatement =
  | Assign
  | SendTo
  | SendUp
  | SendDown
  | Complete
;

rule WorkflowStatement =
  | Fanout
  | Goto
  | ComponentStatement
;

# Group the message pattern so the handler body `{` is not a Then object.
rule ComponentHandler =
  "on" "(" p:Pattern ")" "{" b:ComponentStatement* "}"
  -> { kind: "handler", pattern: p, body: b }
;

rule WorkflowHandler =
  "on" "(" p:Pattern ")" "{" b:WorkflowStatement* "}"
  -> { kind: "handler", pattern: p, body: b }
;

rule JoinAll =
  "join" "all" "{" b:WorkflowStatement* "}"
  -> { kind: "all", body: b }
;

rule StartState =
  "start" n:Identifier "{" h:ComponentHandler* "}"
  -> { kind: "state", name: n, start: true, handlers: h }
;

rule NamedState =
  "state" n:Identifier "{" h:ComponentHandler* "}"
  -> { kind: "state", name: n, start: false, handlers: h }
;

rule State =
  | StartState
  | NamedState
;

rule ComponentDeclaration =
  "component" n:Identifier "{"
    f:Field*
    p:Port*
    s:State+
  "}"
  -> { kind: "component", name: n, fields: f, ports: p, states: s }
;

rule StartStep =
  "start" n:Identifier "{"
    e:WorkflowStatement*
    h:WorkflowHandler*
    j:JoinAll?
  "}"
  -> {
    kind: "step",
    name: n,
    start: true,
    enter: e,
    handlers: h,
    join: (coalesce j null)
  }
;

rule NamedStep =
  "step" n:Identifier "{"
    e:WorkflowStatement*
    h:WorkflowHandler*
    j:JoinAll?
  "}"
  -> {
    kind: "step",
    name: n,
    start: false,
    enter: e,
    handlers: h,
    join: (coalesce j null)
  }
;

rule WorkflowStep =
  | StartStep
  | NamedStep
;

rule WorkflowDeclaration =
  "workflow" n:Identifier "{"
    f:Field*
    p:Port*
    s:WorkflowStep+
  "}"
  -> { kind: "workflow", name: n, fields: f, ports: p, steps: s }
;

rule NamedChild =
  k:Identifier "=" n:Identifier "(" ")" b:InstanceBody? ";"?
  -> {
    kind: "instance",
    component: n,
    key: k,
    children: (coalesce b [])
  }
;

rule UnnamedChild =
  n:Identifier "(" ")" b:InstanceBody? ";"?
  -> {
    kind: "instance",
    component: n,
    key: null,
    children: (coalesce b [])
  }
;

rule ChildConstruction =
  | NamedChild
  | UnnamedChild
;

rule InstanceBody = "{" c:ChildConstruction* "}" -> c;

rule Construction =
  n:Identifier "(" ")" b:InstanceBody? ";"?
  -> {
    kind: "instance",
    component: n,
    key: null,
    children: (coalesce b [])
  }
;

rule SceneBody =
  "scene" n:Identifier "{" r:Construction "}"
  -> { kind: "scene", name: n, root: r }
;

rule ExportedScene =
  "export" s:SceneBody
  -> { exports: [{ kind: "export", name: s.name }], scenes: [s] }
;

rule BareScene =
  s:SceneBody
  -> { exports: [], scenes: [s] }
;

rule ScenePart =
  | ExportedScene
  | BareScene
;

func ProgramFrom<i:any e:any c:any w:any s:any> =
  {
    kind: "program",
    imports: i,
    exports: (flat [(flat e) (flat (pluck s "exports"))]),
    components: c,
    workflows: w,
    scenes: (flat (pluck s "scenes"))
  }
;

rule Program =
  i:Import*
  e:ExportList*
  c:ComponentDeclaration*
  w:WorkflowDeclaration*
  s:ScenePart*
  end
  -> (ProgramFrom i e c w s)
;

[Language { id: "kith", name: "Kith", extensions: [".kith"] }]
rule KithLang =
  |> Source
  |> [TokenizerNoWhitespace]
  |> [Program]
;
