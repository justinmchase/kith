import "@justinmchase/uffda/source" Source;
import "@justinmchase/uffda/tokenizer" TokenizerNoWhitespace;
import "@justinmchase/uffda/pattern" Pattern PatternTokens;
import "@justinmchase/uffda/expression" Expression;

export KithLang;

decorator Language<c:any> = c;

rule Identifier =
  s:string & [(\cL | "_") (\cL | \cNd | "_")*]
  -> s
;

rule SpecifierChar = not "\"" c:any -> c;

rule ModuleSpecifier =
  "\"" p:SpecifierChar* "\""
  -> (join p "")
;

rule ImportName = n:Identifier -> n;

rule Import =
  "import" u:ModuleSpecifier n:ImportName r:ImportName* ";"
  -> { kind: "import", moduleUrl: u, names: (flat [[n] (flat r)]) }
;

rule ExportName = n:Identifier -> { kind: "export", name: n };

rule ExportList =
  "export" not "scene" not "component" not "workflow" f:ExportName r:ExportName* ";"
  -> (flat [[f] (flat r)])
;

rule Field =
  | (
    "field" n:Identifier ":" p:Pattern "=" e:Expression ";"
    -> { kind: "field", name: n, pattern: p, init: e }
  )
  | (
    "field" n:Identifier ":" p:Pattern ";"
    -> { kind: "field", name: n, pattern: p }
  )
;

rule Port =
  not "field" not "start" not "state" not "step" not "join" not "print" not "else" not "goto"
  not "with" not "into" not "fanout"
  k:Identifier n:Identifier ";"
  -> { kind: "port", component: k, name: n }
;

rule Assign =
  n:Identifier "-" ">" e:Expression ";"
  -> { kind: "assign", field: n, expression: e }
;

rule SendUp =
  "send" "up" e:Expression ";"
  -> { kind: "sendUp", message: e }
;

rule SendTo =
  "send" "to" n:Identifier e:Expression ";"
  -> { kind: "sendTo", port: n, message: e }
;

rule SendDown =
  | (
    "send" "down" "any" e:Expression ";"
    -> { kind: "sendDown", component: null, message: e }
  )
  | (
    "send" "down" n:Identifier e:Expression ";"
    -> { kind: "sendDown", component: n, message: e }
  )
;

# `{ kind: "Summarize" total }` is `kind: "Summarize"` plus shorthand `total`.
rule CompleteObjectEntry =
  | (
    n:Identifier ":" v:Expression
    -> { kind: "objectKey", name: n, expression: v }
  )
  | (
    n:Identifier not ":"
    -> { kind: "objectKey", name: n, expression: { kind: "reference", name: n } }
  )
;

rule CompleteObjectTail =
  ","? more:CompleteObjectEntry -> more
;

rule CompleteObjectEntries =
  first:CompleteObjectEntry rest:CompleteObjectTail* ","?
  -> (flat (pack first rest))
;

rule CompleteObject =
  "{" keys:CompleteObjectEntries? "}"
  -> { kind: "object", keys: (coalesce keys []) }
;

rule Complete =
  | (
    "complete" obj:CompleteObject ";"
    -> { kind: "complete", message: obj }
  )
  | (
    "complete" value:Expression ";"
    -> { kind: "complete", message: value }
  )
;

rule Print =
  "print" e:Expression ";"
  -> { kind: "print", expression: e }
;

rule Goto =
  "goto" n:Identifier ";"
  -> { kind: "goto", state: n }
;

rule ComponentStatement =
  | Assign
  | SendTo
  | SendUp
  | SendDown
  | Complete
  | Print
  | Goto
;

# A top-level Pattern is Then: it would take the handler `{` as another object.
# Reparse one object or atom as a complete pattern so the body `{` stays Kith.
# `on (P)` still groups a full Pattern (Or / Then / Pipe).
rule OnObjectChunk =
  | OnObjectTokens
  | (not "{" not "}" t:any -> [t])
;

rule OnObjectTokens =
  o:"{" c:OnObjectChunk* e:"}"
  -> (flat (pack o (flat c) e))
;

rule OnObjectPattern = |> OnObjectTokens |> PatternTokens;

rule OnQuotedString =
  "\"" p:SpecifierChar* "\""
  -> { kind: "equal", value: { kind: "value.literal", value: (join p "") } }
;

rule OnBareTokens = not "{" not "(" t:any -> [t];

rule OnBarePattern = |> OnBareTokens |> PatternTokens;

rule OnCapturePattern =
  n:Identifier ":" p:OnPattern
  -> { kind: "variable", name: n, pattern: p }
;

rule OnPattern =
  | ("(" p:Pattern ")" -> p)
  | OnObjectPattern
  | OnQuotedString
  | OnCapturePattern
  | OnBarePattern
;

# Second pattern cannot start with `{`, or it would eat the handler body.
rule OnItemPattern =
  | ("(" p:Pattern ")" -> p)
  | OnCapturePattern
  | OnBarePattern
;

rule ComponentHandler =
  | (
    "on" a:OnPattern i:OnItemPattern "{" b:ComponentStatement* "}"
    -> { kind: "handler", pattern: a, item: i, body: b }
  )
  | (
    "on" p:OnPattern "{" b:ComponentStatement* "}"
    -> { kind: "handler", pattern: p, body: b }
  )
;

# Default clause, last in the state. Same tree as `on any`.
rule ElseHandler =
  | (
    "else" "{" b:ComponentStatement* "}"
    -> [{ kind: "handler", pattern: { kind: "any" }, body: b }]
  )
  | (
    "else" s:ComponentStatement
    -> [{ kind: "handler", pattern: { kind: "any" }, body: [s] }]
  )
;

rule StartState =
  | (
    "start" "{" h:ComponentHandler* e:ElseHandler? "}"
    -> { kind: "state", name: "Start", start: true, handlers: (flat [h (coalesce e [])]) }
  )
  | (
    "start" n:Identifier "{" h:ComponentHandler* e:ElseHandler? "}"
    -> { kind: "state", name: n, start: true, handlers: (flat [h (coalesce e [])]) }
  )
;

rule NamedState =
  "state" n:Identifier "{" h:ComponentHandler* e:ElseHandler? "}"
  -> { kind: "state", name: n, start: false, handlers: (flat [h (coalesce e [])]) }
;

rule State =
  | StartState
  | NamedState
;

rule ComponentDeclaration =
  "component" n:Identifier "{"
    f:Field*
    p:Port*
    s:State+
  "}"
  -> { kind: "component", name: n, fields: f, ports: p, states: s }
;

rule FlowTarget =
  | ("succeed" -> { kind: "succeed" })
  | ("fail" e:Expression -> { kind: "fail", error: e })
  | (n:Identifier -> { kind: "goto", step: n })
;

rule FlowThen = "then" t:FlowTarget -> t;

rule ChoiceClause =
  | (
    "else" "-" ">" n:Identifier ";"
    -> { pattern: { kind: "any" }, step: n }
  )
  | (
    "(" p:Pattern ")" "-" ">" n:Identifier ";"
    -> { pattern: p, step: n }
  )
;

rule MapInit =
  "(" keys:CompleteObjectEntries? ")"
  -> { kind: "object", keys: (coalesce keys []) }
;

# `{ items orderId }` binds those keys and ignores extras. Not a Uffda Over
# (Over is closed and wants commas). Same shorthand as CompleteObject.
rule StepHead =
  | (p:CompleteObject "-" ">" -> p)
  | (ok -> null)
;

rule StepBody =
  | (
    "fanout" e:Expression "with" k:Identifier "into" r:Identifier i:MapInit?
    -> { kind: "map", items: e, component: k, reduce: r, init: i }
  )
  | ("run" p:Identifier -> { kind: "run", path: p })
  | ("pass" e:Expression -> { kind: "pass", value: e })
  | ("pick" "{" c:ChoiceClause* "}" -> { kind: "choice", clauses: c })
  | ("succeed" -> { kind: "succeed" })
  | ("fail" e:Expression -> { kind: "fail", error: e })
  | (k:Identifier -> { kind: "task", component: k })
;

rule FlowStep =
  | (
    "start" n:Identifier ":" h:StepHead b:StepBody t:FlowThen? ";"
    -> {
      name: n,
      start: true,
      pattern: h,
      body: b,
      next: (coalesce t { kind: "succeed" })
    }
  )
  | (
    "start" h:StepHead b:StepBody t:FlowThen? ";"
    -> {
      name: "Start",
      start: true,
      pattern: h,
      body: b,
      next: (coalesce t { kind: "succeed" })
    }
  )
  | (
    n:Identifier ":" h:StepHead b:StepBody t:FlowThen? ";"
    -> {
      name: n,
      start: false,
      pattern: h,
      body: b,
      next: (coalesce t { kind: "succeed" })
    }
  )
;

rule WorkflowDeclaration =
  "workflow" n:Identifier "{" s:FlowStep+ "}"
  -> { kind: "workflow", name: n, start: "Start", steps: s }
;

rule NamedChild =
  k:Identifier "=" n:Identifier "(" ")" b:InstanceBody? ";"?
  -> {
    kind: "instance",
    component: n,
    key: k,
    children: (coalesce b [])
  }
;

rule UnnamedChild =
  n:Identifier "(" ")" b:InstanceBody? ";"?
  -> {
    kind: "instance",
    component: n,
    key: null,
    children: (coalesce b [])
  }
;

rule ChildConstruction =
  | NamedChild
  | UnnamedChild
;

rule InstanceBody = "{" c:ChildConstruction* "}" -> c;

rule Construction =
  n:Identifier "(" ")" b:InstanceBody? ";"?
  -> {
    kind: "instance",
    component: n,
    key: null,
    children: (coalesce b [])
  }
;

rule SceneBody =
  "scene" n:Identifier "{" r:Construction "}"
  -> { kind: "scene", name: n, root: r }
;

rule ExportedScene =
  "export" s:SceneBody
  -> { exports: [{ kind: "export", name: s.name }], scenes: [s] }
;

rule BareScene =
  s:SceneBody
  -> { exports: [], scenes: [s] }
;

rule ScenePart =
  | ExportedScene
  | BareScene
;

func ProgramFrom<i:any e:any c:any w:any s:any> =
  {
    kind: "program",
    imports: i,
    exports: (flat [(flat e) (flat (pluck s "exports"))]),
    components: c,
    workflows: w,
    scenes: (flat (pluck s "scenes"))
  }
;

rule Program =
  i:Import*
  e:ExportList*
  c:ComponentDeclaration*
  w:WorkflowDeclaration*
  s:ScenePart*
  end
  -> (ProgramFrom i e c w s)
;

[Language { id: "kith", name: "Kith", extensions: [".kith"] }]
rule KithLang =
  |> Source
  |> [TokenizerNoWhitespace]
  |> [Program]
;
